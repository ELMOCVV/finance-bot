# ════════════════════════════════════════════════════════════════════
#  FinanceAI Bot — змінні середовища
#  Скопіюй у .env для локальної розробки.
#  На Railway: додай в Service → Variables.
# ════════════════════════════════════════════════════════════════════

# ── Telegram ─────────────────────────────────────────────────────────
# Отримати у @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Публічний URL бота (Railway видає автоматично).
# Потрібен для webhook-режиму. Залиш порожнім для polling (локально).
# Формат: https://your-bot-service.up.railway.app
WEBHOOK_URL=

# ── Anthropic Claude ──────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── База даних ────────────────────────────────────────────────────────
# Локально:
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# Railway + PostgreSQL (рекомендовано для продакшну):
# Railway автоматично надає $DATABASE_URL при підключенні PostgreSQL плагіна.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Railway: режим сервісу ────────────────────────────────────────────
# Для сервісу «api» — встановити true щоб вбудувати бота в FastAPI
# (один сервіс замість двох). Якщо bot — окремий сервіс, залиш false.
BOT_EMBEDDED=false

# ── CORS (фронтенд) ───────────────────────────────────────────────────
# Локально:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Продакшн (Railway frontend URL):
# CORS_ORIGINS=["https://your-frontend.up.railway.app"]

# ── Зовнішні API (є дефолти, змінювати не потрібно) ─────────────────
NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ── Кеш курсів (секунди) ─────────────────────────────────────────────
EXCHANGE_RATE_CACHE_TTL=3600

# ── Swagger UI (вимкнути в продакшні за бажанням) ───────────────────
# DISABLE_DOCS=true

# ════════════════════════════════════════════════════════════════════
#  Railway: рекомендована схема деплою
#
#  Варіант A — два сервіси (рекомендовано):
#    Сервіс «api»:
#      Start: uvicorn backend.app.main:app --host 0.0.0.0 --port $PORT
#      Vars:  всі з цього файлу + BOT_EMBEDDED=false
#    Сервіс «bot»:
#      Start: python bot/main.py
#      Vars:  TELEGRAM_BOT_TOKEN, ANTHROPIC_API_KEY, DATABASE_URL,
#             WEBHOOK_URL (URL цього сервісу від Railway)
#
#  Варіант B — один сервіс (простіше):
#      Start: uvicorn backend.app.main:app --host 0.0.0.0 --port $PORT
#      Vars:  всі + BOT_EMBEDDED=true + WEBHOOK_URL (URL API-сервісу)
#
#  Важливо: для продакшну замість SQLite підключіть Railway PostgreSQL:
#    Add-on → PostgreSQL → автоматично задає DATABASE_URL
#    + додайте asyncpg в requirements: pip install asyncpg
# ════════════════════════════════════════════════════════════════════
